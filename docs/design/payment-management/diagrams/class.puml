@startuml
!pragma graphviz_dot smetana
' ==============================================================================
' Tên sơ đồ: Class Diagram - Module Quản lý Bảng thanh toán (payment-management)
' Mục đích: Mô tả cấu trúc lớp sau khi Nhóm chốt toàn bộ 8 vấn đề (ISS-01..ISS-08)
'           bao phủ US-PAY-01..05, PAY-01..08 và NFR-01..02.
' Chuẩn tham chiếu: OMG UML 2.5.1
' Trạng thái kết xuất: Đã kiểm tra kết xuất thành công (PlantUML 1.2021.00 - smetana)
' Liên kết yêu cầu: BAITAP_TA_1-2.pdf (Mục 1..6, US-PAY-01..05, PAY-01..08, ISS-01..08)
' ==============================================================================

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "PaymentManagement.Domain" {

    enum PaymentStatus {
        Draft
        PendingApproval
        Approved
        Rejected
        Cancelled
    }

    enum AdjustmentStatus {
        PendingGdkdApproval
        Approved
        Rejected
    }

    enum PeriodType {
        Monthly
        Quarterly
    }

    enum UserRole {
        NVKD
        KTT
        GDKD
    }

    class BillingPeriod <<ValueObject>> {
        +PeriodCode : string
        +PeriodType : PeriodType
        +StartDate : DateOnly
        +EndDate : DateOnly
    }

    class PaymentStatement <<AggregateRoot>> {
        +{static} GdkdApprovalThreshold : decimal = 500000000
        +Id : Guid
        +StatementCode : string
        +ContractId : Guid
        +Period : BillingPeriod
        +TotalAmount : decimal
        +Status : PaymentStatus
        +Note : string?
        +RejectionReason : string?
        +CreatedBy : Guid
        +CreatedAt : DateTimeOffset
        +SubmittedAt : DateTimeOffset?
        +ApprovedBy : Guid?
        +ApprovedAt : DateTimeOffset?
        +RowVersion : uint
        --
        +{static} CreateDraft(contractId : Guid, period : BillingPeriod, lines : IReadOnlyList<PaymentLineInput>, nvkdUserId : Guid, note : string?) : PaymentStatement
        +UpdateDraft(actorId : Guid, note : string?, resyncedLines : IReadOnlyList<PaymentLineInput>?) : void
        +Submit(actorId : Guid, mandatoryServiceIds : IReadOnlyCollection<Guid>) : void
        +GetRequiredApproverRole() : UserRole
        +Approve(approverId : Guid, approverRole : UserRole) : void
        +Reject(approverId : Guid, approverRole : UserRole, reason : string) : void
        +ReviseToDraft(nvkdActorId : Guid) : void
        +Cancel(actorId : Guid) : void
        +CreateAdjustment(kttActorId : Guid, confirmationDocUrl : string, reason : string, adjustedLines : IReadOnlyList<PaymentLineInput>) : PaymentAdjustment
    }

    class PaymentLine <<Entity>> {
        +Id : Guid
        +PaymentStatementId : Guid
        +ServiceId : Guid
        +ServiceCode : string
        +ServiceName : string
        +Quantity : decimal
        +UnitPrice : decimal
        +LineAmount : decimal
    }

    class PaymentAdjustment <<Entity>> {
        +Id : Guid
        +PaymentStatementId : Guid
        +AdjustmentCode : string
        +ConfirmationDocumentUrl : string
        +Reason : string
        +PreviousTotalAmount : decimal
        +AdjustedTotalAmount : decimal
        +Status : AdjustmentStatus
        +CreatedByKttId : Guid
        +CreatedAt : DateTimeOffset
        +ApprovedByGdkdId : Guid?
        +ApprovedAt : DateTimeOffset?
        --
        +ApproveByGdkd(gdkdUserId : Guid) : void
    }

    class PaymentAdjustmentLine <<Entity>> {
        +Id : Guid
        +PaymentAdjustmentId : Guid
        +ServiceId : Guid
        +Quantity : decimal
        +UnitPrice : decimal
        +LineAmount : decimal
    }

    class PaymentAuditLog <<Entity>> {
        +Id : Guid
        +PaymentStatementId : Guid
        +AdjustmentId : Guid?
        +ActorId : Guid
        +OccurredAt : DateTimeOffset
        +Action : string
        +OldStatus : string?
        +NewStatus : string
        +ChangeDetailsJson : string
    }

    PaymentStatement "1" *-- "1..*" PaymentLine : contains >
    PaymentStatement "1" *-- "0..*" PaymentAdjustment : has adjustments (ISS-03) >
    PaymentAdjustment "1" *-- "1..*" PaymentAdjustmentLine : contains >
    PaymentStatement --> PaymentStatus : status
    PaymentAdjustment --> AdjustmentStatus : status
    PaymentStatement *-- "1" BillingPeriod : period (ISS-04)
    PaymentAuditLog "0..*" --> "1" PaymentStatement : audits >
}

package "PaymentManagement.Application" {

    interface IPaymentStatementAppService {
        +CreateStatementAsync(req : CreatePaymentStatementRequest, actorId : Guid, ct : CancellationToken) : Task<PaymentStatementDto>
        +UpdateDraftAsync(id : Guid, req : UpdateDraftRequest, actorId : Guid, ct : CancellationToken) : Task<PaymentStatementDto>
        +SubmitStatementAsync(id : Guid, idempotencyKey : string, rowVersion : uint, actorId : Guid, ct : CancellationToken) : Task<PaymentStatementDto>
        +ApproveStatementAsync(id : Guid, rowVersion : uint, actorId : Guid, role : UserRole, ct : CancellationToken) : Task<PaymentStatementDto>
        +RejectStatementAsync(id : Guid, reason : string, rowVersion : uint, actorId : Guid, role : UserRole, ct : CancellationToken) : Task<PaymentStatementDto>
        +ReviseRejectedToDraftAsync(id : Guid, rowVersion : uint, actorId : Guid, ct : CancellationToken) : Task<PaymentStatementDto>
        +CancelDraftAsync(id : Guid, rowVersion : uint, actorId : Guid, ct : CancellationToken) : Task<void>
        +CreateAdjustmentAsync(id : Guid, req : CreateAdjustmentRequest, kttActorId : Guid, ct : CancellationToken) : Task<PaymentAdjustmentDto>
        +ApproveAdjustmentByGdkdAsync(id : Guid, adjId : Guid, gdkdActorId : Guid, ct : CancellationToken) : Task<PaymentAdjustmentDto>
    }

    class PaymentStatementAppService

    interface IContractReadService <<ReadOnlyPort>> {
        +GetContractSummaryAsync(contractId : Guid, ct : CancellationToken) : Task<ContractReadDto?>
    }

    interface IPriceListReadService <<ReadOnlyPort>> {
        +GetApplicablePriceListAsync(contractId : Guid, period : BillingPeriod, ct : CancellationToken) : Task<PriceListReadDto?>
    }

    interface IVolumeReadService <<ReadOnlyPort>> {
        +GetPeriodVolumeAsync(contractId : Guid, period : BillingPeriod, ct : CancellationToken) : Task<VolumeReadDto?>
    }

    interface INotificationService <<Port>> {
        +NotifyApproverAsync(statementId : Guid, approverRole : UserRole, excludedUserId : Guid, totalAmount : decimal, ct : CancellationToken) : Task
    }

    interface IPaymentStatementRepository <<Repository>> {
        +ExistsNonCancelledForPeriodAsync(contractId : Guid, periodCode : string, ct : CancellationToken) : Task<bool>
        +GetByIdAsync(id : Guid, ct : CancellationToken) : Task<PaymentStatement?>
        +AddAsync(statement : PaymentStatement, ct : CancellationToken) : Task
        +UpdateAsync(statement : PaymentStatement, ct : CancellationToken) : Task
    }

    interface IPaymentAuditLogRepository <<Repository>> {
        +AddAsync(auditLog : PaymentAuditLog, ct : CancellationToken) : Task
    }

    PaymentStatementAppService ..|> IPaymentStatementAppService
    PaymentStatementAppService --> IPaymentStatementRepository
    PaymentStatementAppService --> IPaymentAuditLogRepository
    PaymentStatementAppService --> IContractReadService
    PaymentStatementAppService --> IPriceListReadService
    PaymentStatementAppService --> IVolumeReadService
    PaymentStatementAppService --> INotificationService
    PaymentStatementAppService ..> PaymentStatement : orchestrates
}

package "PaymentManagement.Presentation" {
    class PaymentStatementsController {
        -appService : IPaymentStatementAppService
        +Create(req : CreatePaymentStatementRequest) : Task<IActionResult>
        +UpdateDraft(id : Guid, req : UpdateDraftRequest) : Task<IActionResult>
        +Submit(id : Guid, idempotencyKey : string, req : SubmitRequest) : Task<IActionResult>
        +Approve(id : Guid, req : ApproveRequest) : Task<IActionResult>
        +Reject(id : Guid, req : RejectRequest) : Task<IActionResult>
        +Revise(id : Guid, req : ReviseRequest) : Task<IActionResult>
        +Cancel(id : Guid, req : CancelRequest) : Task<IActionResult>
        +CreateAdjustment(id : Guid, req : CreateAdjustmentRequest) : Task<IActionResult>
        +ApproveAdjustment(id : Guid, adjId : Guid) : Task<IActionResult>
    }

    PaymentStatementsController --> IPaymentStatementAppService
}
@enduml